DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=rapfadrop
POSTGRES_USER=rapfadrop
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
RAPFADROP_MEDIA_ROOT=/var/lib/rapfadrop/media
RAPFADROP_MEDIA_PROVIDER_ORDER=yt-dlp
RAPFADROP_MEDIA_MAX_UPLOAD_BYTES=104857600
RAPFADROP_MEDIA_ALLOWED_AUDIO_EXTENSIONS=mp3,m4a,mp4,aac,flac,ogg,opus,wav,aiff,aif
RAPFADROP_MEDIA_MAX_ARTWORK_BYTES=8388608
RAPFADROP_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=240
RAPFADROP_MEDIA_EXPECTED_DURATION_TOLERANCE_SECONDS=5
RAPFADROP_MEDIA_TRUNCATION_RATIO=0.9
RAPFADROP_MEDIA_CHANNEL_TAG=@RapFaDrop
RAPFADROP_MEDIA_AUTHOR_URL=https://t.me/RapFaDrop
RAPFADROP_MEDIA_CHANNEL_TAG_FIELDS=subtitle,comments,album_artist_suffix,album_suffix,publisher,encoded_by,author_url,copyright,composers,conductors,initial_key
